# Independent Service Ports
PORT=3001
AGENT_PORT=3002
FRONTEND_PORT=3000

# Service Discovery URLs
BACKEND_API_URL=http://localhost:3001
AGENT_API_URL=http://localhost:3002

# Optional: Set your Gemini API Key if you want to use live LLM function calling
# If omitted, the project automatically runs using the built-in intelligent MCP routing simulation.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
